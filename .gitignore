# Obsidian workspace/local state — machine-specific, don't share across devices
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# SETUP/COMMODORE — keep routine machine-generated logs local only
SETUP/COMMODORE/logs/*
!SETUP/COMMODORE/logs/.gitkeep
